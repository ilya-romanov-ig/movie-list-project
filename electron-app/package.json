{
  "name": "movie-recommender-desktop",
  "version": "1.0.0",
  "description": "Desktop версия Movie Recommender приложения",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:prod": "cd ../project/front && npm run build",
    "copy:dist": "cp -r ../project/front/dist ./dist",
    "pack": "npm run build:prod && npm run copy:dist && electron-builder --dir",
    "dist": "npm run build:prod && npm run copy:dist && electron-builder",
    "dist:win": "npm run build:prod && npm run copy:dist && electron-builder --win",
    "dist:mac": "npm run build:prod && npm run copy:dist && electron-builder --mac",
    "dist:linux": "npm run build:prod && npm run copy:dist && electron-builder --linux",
    "docker:up": "cd ../project && docker-compose up -d",
    "docker:down": "cd ../project && docker-compose down",
    "docker:logs": "cd ../project && docker-compose logs -f"
  },
  "keywords": ["electron", "vue", "fastapi", "movie", "recommender"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.6.4",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.movierecommender.desktop",
    "productName": "Movie Recommender",
    "copyright": "Copyright © 2024 Movie Recommender",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "publisherName": "Movie Recommender"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "../project/docker-compose.yml",
        "to": "docker/docker-compose.yml"
      },
      {
        "from": "scripts/",
        "to": "scripts/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}